<Window x:Class="ExamSession.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Session" Width="620" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#EEEEEE" FontSize="14">
    <TabControl Margin="20">

        <!-- Mock exam -->
        <TabItem Header="Mock exam">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ExamsDirText" Margin="0,0,0,10"
                           Foreground="#999999" FontSize="12" TextTrimming="CharacterEllipsis" />

                <ListBox x:Name="ExamList" Grid.Row="1" DisplayMemberPath="Name"
                         Background="#252526" Foreground="#EEEEEE" BorderBrush="#3C3C3C"
                         MouseDoubleClick="OnStartClicked" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,16">
                    <Button Content="Refresh" Click="OnRefreshClicked" />
                    <Button Content="Browse..." Click="OnBrowseClicked" />
                    <Button Content="Open exams folder" Click="OnOpenFolderClicked" />
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Writing time (minutes)" VerticalAlignment="Center" />
                    <TextBox x:Name="WritingBox" Grid.Column="1" Text="120" Margin="0,4" Padding="4" />

                    <TextBlock Grid.Row="1" Text="Reading time (minutes)" VerticalAlignment="Center" />
                    <TextBox x:Name="ReadingBox" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,4" Padding="4" />

                    <TextBlock Grid.Row="2" Text="Exit password (optional)" VerticalAlignment="Center" />
                    <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4" />
                </Grid>

                <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#F48771" Margin="0,8,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <Button Grid.Row="5" Content="Start exam" Click="OnStartClicked" HorizontalAlignment="Right"
                        Margin="0,16,0,0" Padding="24,8" FontWeight="SemiBold" IsDefault="True" />
            </Grid>
        </TabItem>

        <!-- Focus -->
        <TabItem Header="Focus">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="AssignmentsDirText" Margin="0,0,0,10"
                           Foreground="#999999" FontSize="12" TextTrimming="CharacterEllipsis" />

                <ListBox x:Name="AssignmentList" Grid.Row="1" DisplayMemberPath="Name" SelectionMode="Extended"
                         ToolTip="Ctrl+click or Shift+click to pick several PDFs; switch between them during the session."
                         Background="#252526" Foreground="#EEEEEE" BorderBrush="#3C3C3C" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,16">
                    <Button Content="Refresh" Click="OnRefreshAssignmentsClicked" />
                    <Button Content="Browse..." Click="OnBrowseAssignmentClicked" />
                    <Button Content="Open assignments folder" Click="OnOpenAssignmentsFolderClicked" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,6">
                    <TextBlock Text="Apps allowed alongside the PDF" FontWeight="SemiBold" />
                    <TextBlock Text="Open the app first so it shows up here. Everything else gets minimized."
                               Foreground="#999999" FontSize="12" />
                </StackPanel>

                <ListBox x:Name="AppList" Grid.Row="4"
                         Background="#252526" Foreground="#EEEEEE" BorderBrush="#3C3C3C">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Foreground="#EEEEEE">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,16">
                    <Button Content="Refresh apps" Click="OnRefreshAppsClicked" />
                    <Button Content="Add .exe..." Click="OnAddAppClicked" />
                </StackPanel>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Duration (minutes, 0 = no limit)" VerticalAlignment="Center" />
                    <TextBox x:Name="DurationBox" Grid.Column="1" Text="60" Margin="0,4" Padding="4" />

                    <TextBlock Grid.Row="1" Text="Exit password (optional)" VerticalAlignment="Center" />
                    <PasswordBox x:Name="FocusPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4" />
                </Grid>

                <TextBlock x:Name="FocusErrorText" Grid.Row="7" Foreground="#F48771" Margin="0,8,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <Button Grid.Row="8" Content="Start focus" Click="OnStartFocusClicked" HorizontalAlignment="Right"
                        Margin="0,16,0,0" Padding="24,8" FontWeight="SemiBold" IsDefault="True" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
